  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:native",
    "build:native": "node scripts/build-native.mjs",
    "build:cli": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3"
  }
}
