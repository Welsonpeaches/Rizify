{
  "name": "rizify-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rizify launcher for the Linux QQ 3.2.34-53644 Milky protocol service",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rizify": "./dist/index.mjs"
  },
  "files": [
