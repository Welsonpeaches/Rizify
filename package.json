{
  "name": "rizify",
  "private": true,
  "version": "0.1.0",
  "description": "Rizify — Linux QQ 3.2.34-53644 Milky protocol service based on Acidify + Yogurt",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter rizify-cli build",
    "build:native": "pnpm --filter rizify-cli build:native",
    "build:cli": "pnpm --filter rizify-cli build:cli",
    "start": "node rizify-cli/dist/index.mjs",
    "typecheck": "pnpm --filter rizify-cli typecheck",
    "build:core-js": "pnpm --filter @acidify/core build",
    "build:docs": "pnpm --filter @acidify/docs build",
    "dev:docs": "pnpm --filter @acidify/docs dev"
  }
}
